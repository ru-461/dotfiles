#################################  COMMON  #################################

# chezmoi source directory, rendered by chezmoi at apply time.
DOTFILES_DIR="{{ .chezmoi.sourceDir }}"
FUNCTIONS_DIR="${DOTFILES_DIR}/functions"

# Load interactive helpers only. Installer helpers (_common/_brew/_bundle_brew/_zsh) are bash-only.
for _fn in _decorate_output.sh _has.sh _auto_upgrade.sh _delete_stores.sh; do
  [[ -r "${FUNCTIONS_DIR}/${_fn}" ]] && source "${FUNCTIONS_DIR}/${_fn}"
done
unset _fn

if ! typeset -f has > /dev/null 2>&1; then
  has() {
    command -v "$1" > /dev/null 2>&1
  }
fi

typeset -f headline > /dev/null 2>&1 && headline "Welcome to Zsh!"

# OS
case $OSTYPE in
  linux-android*)
    OS=linux-android
    ;;
  darwin*)
    OS=darwin
    ;;
  linux*)
    OS=linux
    ;;
  *)
    OS=unknown
    ;;
esac


#################################  ZSH INIT  #################################

# Completions
zstyle ":completion:*" verbose yes
zstyle ":completion:*:commands" rehash 1
zstyle ":completion:*" completer _extensions _complete _approximate
zstyle ":completion:*:default" list-colors ${(s.:.)LS_COLORS}
zstyle ":completion:*" matcher-list "m:{a-z}={A-Z}"
zstyle ":completion:*" menu select
zstyle ":completion:*" group-name ""
zstyle ":completion:*:*:*:*:descriptions" format "%F{green}-- %d --%f"

setopt auto_cd
setopt correct

# Lang
export LANG=ja_JP.UTF-8
setopt print_eight_bit

# Homebrew
export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

# Zsh history
HISTFILE=${HOME}/.zsh_history
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS

# Setting beep
setopt no_beep
setopt nolistbeep

# Configure path
typeset -U path PATH
path=(
  /opt/homebrew/bin(N-/)
  /opt/homebrew/sbin(N-/)
  /data/data/com.termux/files/usr/bin(N-/)
  /usr/bin(N-/)
  /usr/sbin(N-/)
  /bin(N-/)
  /sbin(N-/)
  /usr/local/bin(N-/)
  /usr/local/sbin(N-/)
  /Library/Apple/usr/bin(N-/)
  $HOME/fvm/default/bin(N-/)
  ${path}
)

# herdr: attach to the persistent session on SSH login. HERDR_SKIP=1 to bypass.
if [[ -n "${SSH_CONNECTION:-}" && -z "${HERDR_ENV:-}" && -z "${HERDR_SKIP:-}" && -t 0 && -t 1 ]] &&
   has herdr; then
  herdr session attach works && exit
  print -u2 "herdr attach failed (exit $?); starting a plain shell instead."
fi


#################################  TOOL INIT  #################################

# Android
if [[ ${OS} = "darwin" && -d "${HOME}/Library/Android/sdk" ]]; then
  export ANDROID_HOME="${HOME}/Library/Android/sdk"
  export ANDROID_SDK_ROOT="${ANDROID_HOME}"
  _ndk=( "${ANDROID_HOME}"/ndk/*(N/nOn) )  # newest version first (numeric sort)
  (( ${#_ndk} )) && export NDK_HOME="${_ndk[1]}"
  unset _ndk
  path+=(
    "${ANDROID_HOME}/cmdline-tools/latest/bin"
    "${ANDROID_HOME}/platform-tools"
    "${ANDROID_HOME}/emulator"
  )
fi

# Brew
if [[ ! ${OS} = "darwin" && ! ${OS} = "linux-android" ]]; then
  if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
fi

# Enable completion & Autosuggestions
if has "brew"; then
  ZSH_AUTOSUGGESTIONS_FILE="$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -f "${ZSH_AUTOSUGGESTIONS_FILE}" ]] && source "${ZSH_AUTOSUGGESTIONS_FILE}"
  FPATH=$(brew --prefix)/share/zsh-completions:${FPATH}
  autoload -Uz compinit && compinit
fi

# Bun
if has "bun"; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# GitHub CLI
if has "gh"; then
  eval "$(gh completion -s zsh)"
fi

# Rust
[[ -f "$HOME/.cargo/env" ]] && source $HOME/.cargo/env

# tabtab source for packages
[[ -f ~/.config/tabtab/zsh/__tabtab.zsh ]] && . ~/.config/tabtab/zsh/__tabtab.zsh


#################################  ALIASES  #################################

# Search aliases by keyword.
ag() {
  if has "rg"; then
    alias | rg -- "${1:-}"
  else
    alias | grep -- "${1:-}"
  fi
}

# dotfiles
alias dot='code "${DOTFILES_DIR}"'
alias cdot='cd "${DOTFILES_DIR}"'
alias clodot="git clone git@github.com:ru-461/dotfiles.git ${HOME}/dotfiles"

# System
alias re="exec ${SHELL} -l"
alias c="clear"
alias cls="clear"
alias q="exit"
alias a="alias"
alias h="history"
has "procs" && alias ps="procs"
[[ ${OS} = "darwin" ]] && alias o="open ."

# Cd
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# eza
if has "eza"; then
  alias ei="eza --icons --git"
  alias ea="eza -a --icons --git"
  alias ee="eza -aahl --icons --git"
  alias et="eza -T -L 3 -a -I 'node_modules|.git|.cache' --icons"
  alias eta="eza -T -a -I 'node_modules|.git|.cache' --color=always --icons | less -r"
  alias ls=ei
  alias la=ea
  alias ll=ee
  alias lt=et
  alias lta=eta
fi
alias l="clear && ls"

# Git
alias g="git"

# .zshrc
alias czsh='code "$(chezmoi source-path ~/.zshrc)"'
alias szsh='source ~/.zshrc'

# VSCode
alias codeinit="mkdir -p ./.vscode && touch ./.vscode/settings.json"

# ZennCLI
alias zenna="cd ${HOME}/Documents/zenn-articles"
alias zennb="cd ${HOME}/Documents/zenn-books"
alias zennop="zenna && code ${HOME}/Documents/my-zenn-contents && npx zenn preview --open"
alias zennna="zenna && npx zenn new:article"
alias zennnas="zenna && npx zenn new:article --slug"
alias zennnb="zenna && npx zenn new:book"
alias zennnbs="zenna && npx zenn new:book --slug "
alias zennpr="zenna && npx zenn preview --open"
alias zennv="zenna && npx zenn --version"

# Bun
alias bxsort="bunx sort-package-json"
alias bxserve="bunx serve"
alias bxfast="bunx fast-cli"
alias bxcheck="bunx npm-check-updates"
alias bunx="bun x"

# Yarn
alias y="yarn"
alias ygl="yarn global list --depth=0"
alias yal="yarn list --depth=0"
alias yga="yarn global add"
alias ya="yarn add"
alias yad="yarn add --dev"
alias yrm="yarn remove"
alias yupg="yarn upgrade"
alias yout="yarn outdated"
alias yrun="yarn run"
alias ysrun="yarn -s run"
alias ydev="yarn dev"

# fvm
alias f="fvm flutter"
alias fv=".fvm/flutter_sdk/bin/flutter"

# pnpm
alias pn="pnpm"

# pip
alias p="pip"

# venv
alias va="source .venv/bin/activate"

# Multipass
alias mp="multipass"
alias mpl="multipass list"
alias mpre="multipass restart"

# scrcpy
alias sc="scrcpy"
alias sctop="scrcpy -S --always-on-top --window-x 2200 --window-y 50 -m 1080"
alias scfull="scrcpy -S --fullscreen"

# Docker
if has "docker"; then
  alias d="docker"
  alias dp="docker container ls"
  alias dpla="docker container ls --all --latest"
  alias dr="docker container run"
  alias ds="docker container stop"
  alias dx="docker exec --interactive --tty"
  alias dcrm='docker container rm --force $(docker ps --all --quiet)'
  alias di="docker image"
  alias dila="docker image ls --all"
  alias dirm='docker rmi -f $(docker images --quiet)'
  alias dn="docker network"
  alias dnls="docker network ls"
  alias dc="docker compose"
  alias dcx="docker compose exec --interactive --tty"
  alias dcb="docker compose build --force-rm"
  alias dcup="docker compose up --detach"
  alias dcupb="docker compose up --detach --build"
  alias dcd="docker compose down"
  alias dcre="docker compose restart"
  alias drm="docker system prune"
fi

# Laravel Sail
unalias sail 2> /dev/null
function sail {
  if [[ -f sail ]]; then
    sh sail "$@"
  else
    sh vendor/bin/sail "$@"
  fi
}

# Starship
alias ship='code "$(chezmoi source-path ~/.config/starship.toml)"'

# Homebrew
alias brewL="brew leaves"
alias brewc="brew cleanup"
alias brewd="brew doctor"
alias brewi="brew install"
alias brewl="brew list"
alias brewo="brew outdated"
alias brews="brew search"
alias brewu="brew upgrade"
alias brewx="brew uninstall"
# Brew Bundle
if has "brew"; then
  alias brewbnd="brew bundle --file ${DOTFILES_DIR}/Brewfile"
fi

# mas-cli
if [[ ${OS} = "darwin" ]]; then
  alias masi="mas install"
  alias masl="mas list"
  alias maso="mas outdated"
  alias mass="mas search"
  alias masu="mas upgrade"
  alias masx="mas uninstall"
fi

# Starship init
if has "starship"; then
  eval "$(starship init zsh)"
fi

# mise
if has "mise"; then
  eval "$(mise activate zsh)"
fi

# uv
if has "uv"; then
  eval "$(uv generate-shell-completion zsh)"
fi

# uvx
if has "uvx"; then
  eval "$(uvx --generate-shell-completion zsh)"
fi
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

fpath+=~/.zfunc; autoload -Uz compinit; compinit
